# Скопируйте в .env и задайте свои значения: cp .env.example .env
# Файл .env не коммитится.

API_PORT=8080

POSTGRES_DB=curator
POSTGRES_USER=curator
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

FILE_STORAGE_PORT=9000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Database="Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};GSS Encryption Mode=Disable"
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-chars

FileStorage__ServiceUrl=http://storage:9000
FileStorage__Region=us-east-1
FileStorage__Bucket=curator-avatars
FileStorage__AccessKey=change-me-access-key
FileStorage__SecretKey=change-me-secret-key-at-least-8-chars
FileStorage__PublicBaseUrl=http://localhost:${FILE_STORAGE_PORT:-9000}/${FileStorage__Bucket}
FileStorage__ForcePathStyle=true

Smtp__Host=mailpit
Smtp__Port=1025
Smtp__StartTls=false
Smtp__From=no-reply@curator.test
