{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "curator-api",
    "Audience": "curator-client",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  }
}
