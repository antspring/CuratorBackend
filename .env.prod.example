CURATOR_API_IMAGE=ghcr.io/antspring/curator-backend:latest
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

DATABASE_CONNECTION_STRING='Host=db.example;Port=5432;Database=curator;Username=curator;Password=change-me;SSL Mode=VerifyFull'
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-chars
CORS_ALLOWED_ORIGIN=https://curator.example

FILE_STORAGE_SERVICE_URL=https://s3.yandexcloud.net
FILE_STORAGE_REGION=ru-central1
FILE_STORAGE_BUCKET=curator-avatars
FILE_STORAGE_ACCESS_KEY=change-me-access-key
FILE_STORAGE_SECRET_KEY=change-me-secret-key
FILE_STORAGE_PUBLIC_BASE_URL=https://storage.yandexcloud.net/curator-avatars
FILE_STORAGE_FORCE_PATH_STYLE=true
