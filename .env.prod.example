ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Database=Host=db.example;Port=5432;Database=curator;Username=curator;Password=change-me;SSL Mode=VerifyFull
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-chars
Cors__AllowedOrigins__0=https://curator.example

FileStorage__ServiceUrl=https://s3.yandexcloud.net
FileStorage__Region=ru-central1
FileStorage__Bucket=curator-avatars
FileStorage__AccessKey=change-me-access-key
FileStorage__SecretKey=change-me-secret-key
FileStorage__PublicBaseUrl=https://storage.yandexcloud.net/curator-avatars
FileStorage__ForcePathStyle=true

Smtp__Host=postbox.cloud.yandex.net
Smtp__Port=587
Smtp__StartTls=true
Smtp__From=no-reply@your-domain.example
Smtp__Username=your-postbox-api-key-id
Smtp__Password=your-postbox-api-key-secret
